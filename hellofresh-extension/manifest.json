{
  "manifest_version": 3,
  "name": "HelloFresh Meal Ratings",
  "version": "1.0.0",
  "description": "Displays your personal Google Sheet average meal ratings (1-10 color scale) on HelloFresh meal selection cards.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/spreadsheets/d/1mQOm4Cge3Oz5DVFKsj7uGXiLjC9RIq1f8_RaLatYB8E/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HelloFresh Meal Ratings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hellofresh.com/*"
      ],
      "js": [
        "page_preload.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.hellofresh.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "default_ratings.json"
      ],
      "matches": [
        "https://www.hellofresh.com/*"
      ]
    }
  ]
}
